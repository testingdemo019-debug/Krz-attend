# ───────── Application ─────────
# dev | prod
APP_ENV=dev
# Set by build scripts; shown in Settings → System → About
APP_VERSION=0.6.0
# Public URL used ONLY for absolute links in e-mails (prod: https://<host> — PENDING).
# OIDC redirects are built from forwarded headers, not from this value.
APP_BASE_URL=http://localhost:5173
# Default for Settings → General; all display and day logic
APP_TIMEZONE=Asia/Kolkata
ORG_NAME=KRZ Technologies Pvt. Ltd.
ORG_DOMAIN=krztechnologies.com
# Comma-separated work e-mails that become System Administrator on first sign-in, only while no admin exists
BOOTSTRAP_ADMIN_EMAILS=
# IT's address shown on the sign-in screen ("Trouble signing in? Contact IT"); empty = no address (PENDING P-31)
IT_HELPDESK_EMAIL=
# HOST path of the data folder, relative to deploy/ (or absolute).
# Inside containers, compose sets DATA_DIR=/data. A backend run on the host from backend/ resolves ../data to the same folder.
DATA_DIR=../data

# ───────── PostgreSQL (already installed on the host — NOT a container) ─────────
# From containers: host.docker.internal is mapped to the internal network gateway 172.28.0.1 in compose.
# The dev profile on the host uses localhost.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=krz_attend
# Flyway migrations only
DB_OWNER_USER=krz_owner
# Generated by database/bootstrap/run_bootstrap (reused if already set)
DB_OWNER_PASSWORD=
# Backend runtime
DB_APP_USER=krz_app
DB_APP_PASSWORD=
# Worker: SELECT on v_worker_* views only
DB_WORKER_USER=krz_worker
DB_WORKER_PASSWORD=
DB_POOL_MAX=20
# The postgres superuser password is NEVER stored here. run_bootstrap asks for it interactively.

# ───────── Redis (container) ─────────
# Dev on host: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BACKEND_USER=krz_backend
# Generated by deploy/scripts/init-env
REDIS_BACKEND_PASSWORD=
REDIS_WORKER_USER=krz_worker
REDIS_WORKER_PASSWORD=
# PING-only user for the container health check
REDIS_HEALTH_PASSWORD=

# ───────── Microsoft Entra ID ─────────
# Dummy development values — the user will correct them later
ENTRA_TENANT_ID=e22ee77f-6833-41a0-a000-fd7b79caccc4
ENTRA_CLIENT_ID=e38f561b-6931-434c-b167-2651b89b8eaa
# The user pastes this themselves. Never commit, print or log it.
ENTRA_CLIENT_SECRET=
# yyyy-mm-dd (from Entra → Certificates & secrets) — drives NR-09
ENTRA_CLIENT_SECRET_EXPIRES=
ENTRA_ALLOWED_DOMAIN=krztechnologies.com
# all | groups
ENTRA_SYNC_SCOPE=all
# Entra group object IDs, only when scope=groups (needs GroupMember.Read.All)
ENTRA_SYNC_GROUP_IDS=
# Comma-separated UPNs never synced (service/shared mailboxes)
ENTRA_SYNC_EXCLUDE=attend-noreply@krztechnologies.com

# ───────── Sessions ─────────
# The idle timeout is a UI setting (default 30 min)
SESSION_ABSOLUTE_HOURS=12

# ───────── E-mail (Microsoft Graph sendMail — real) ─────────
MAIL_ENABLED=true
# graph | log   (log = write to the log only, no sending)
MAIL_PROVIDER=graph
MAIL_SENDER=attend-noreply@krztechnologies.com
# Dev: if set, EVERY e-mail goes only here (the subject is prefixed with the real recipient)
MAIL_TEST_RECIPIENT=

# ───────── Mobile push (no app yet) ─────────
# PushSender = DisabledPushSender. Keep false until a mobile app exists (PENDING).
PUSH_ENABLED=false

# ───────── KRZ HRMS (not connected yet) ─────────
# HrmsClient = DummyHrmsClient; punches are held as HELD_NOT_CONNECTED
HRMS_ENABLED=false
# PENDING — HRMS API specification
HRMS_BASE_URL=
HRMS_API_KEY=

# ───────── Encryption (AES-256-GCM, shared by backend and worker) ─────────
ENCRYPTION_ACTIVE_KEY_ID=k1
# Base64 of 32 random bytes, generated by init-env. Losing it means losing all templates and crops — back it up separately (RUNBOOK).
ENCRYPTION_KEY_k1=

# ───────── Internal service auth (generated by init-env) ─────────
# Backend → worker API header X-Worker-Token (48+ random characters)
WORKER_API_TOKEN=
GO2RTC_API_USER=krz_relay
GO2RTC_API_PASSWORD=

# ───────── Service URLs (the dev profile on the host uses http://localhost:8090 and http://localhost:1984) ─────────
WORKER_API_URL=http://worker:8090
MEDIA_RELAY_URL=http://media-relay:1984

# ───────── Docker host integration ─────────
# Group ID of the deploy user on the host (id -g). Containers run as 10001:<this> so backups can read their files.
DEPLOY_GID=1000
# Linux: leave empty (compose uses 172.28.0.1). Docker Desktop (Windows/macOS): host-gateway
DOCKER_HOST_GATEWAY=

# ───────── Worker ─────────
WORKER_ID=worker-1
# tensorrt | cuda | cpu   (cpu = slow, for dev machines without a GPU)
WORKER_EXECUTION_PROVIDER=cuda
WORKER_GPU_DEVICE=0
# Frames processed per second per camera
WORKER_MAX_FPS=12
WORKER_API_PORT=8090
# Container paths (bind-mounted from ${DATA_DIR})
MODELS_DIR=/models
TRT_CACHE_DIR=/data/trt_cache
# Subnet scanned by "Find cameras" (unicast ONVIF probe; multicast does not leave the Docker bridge)
CAMERA_DISCOVERY_SUBNET=192.168.1.0/24

# ───────── Development only ─────────
# Dev profile: if no camera exists, create CAM-01 (at the dev-seed location VLR / entry point EP-01) from the values below
DEV_CAMERA_SEED=true
CAMERA_01_HOST=192.168.1.2
CAMERA_01_RTSP_PORT=554
CAMERA_01_ONVIF_PORT=80
# Main stream → worker (recognition)
CAMERA_01_MAIN_PATH=/video/live?channel=1&subtype=0
# Sub stream → go2rtc → browser Live View
CAMERA_01_SUB_PATH=/video/live?channel=1&subtype=1
# A view-only camera user, not admin
CAMERA_01_USERNAME=
# The user types it; it is encrypted into the DB on first start, then edited only in Settings → Cameras
CAMERA_01_PASSWORD=
# Dev profile: generate fake crossings through the real pipeline (no camera needed)
DEV_SYNTHETIC_CROSSINGS=false

# ───────── Backups ─────────
BACKUP_DIR=../data/backups
BACKUP_KEEP_DAYS=14
# Optional: encrypt dumps with it (gpg --symmetric, passphrase passed via a file descriptor)
BACKUP_PASSPHRASE=
