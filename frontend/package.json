{
  "name": "krz-attend-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "KRZ Attend web app: React + TypeScript conversion of docs/prototype/index.html, driven by the backend API.",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "mediapipe": "node scripts/mediapipe.mjs",
    "predev": "npm run mediapipe",
    "dev": "vite",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prebuild": "npm run mediapipe",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "e2e": "playwright test --project=e2e",
    "parity:refs": "playwright test --project=references",
    "parity": "playwright test --project=parity",
    "smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mediapipe/tasks-vision": "1.0.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "9.3.1",
    "get-nonce": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
